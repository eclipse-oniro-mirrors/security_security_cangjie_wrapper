// The Cangjie API is in Beta. For details on its capabilities and limitations, please refer to the README file.

package ohos.security.crypto_framework

import ohos.ffi.{RemoteDataLite, releaseFFIData}
import ohos.labels.APILevel
import ohos.business_exception.{BusinessException, ERR_PARAMETER_ERROR}
import std.math.numeric.BigInt

foreign {
    func FFiOHOSPriKeyGetAsyKeySpecByNum(id: Int64, itemType: Int32, errCode: CPointer<Int32>): IntNative

    func FFiOHOSPriKeyGetAsyKeySpecByStr(id: Int64, itemType: Int32, errCode: CPointer<Int32>): CString

    func FFiOHOSPriKeyGetAsyKeySpecByBigInt(id: Int64, itemType: Int32, errCode: CPointer<Int32>): HcfBigInteger

    func FFiOHOSPriKeyGetEncoded(id: Int64, errCode: CPointer<Int32>): HcfBlob

    func FFiOHOSPriKeyGetEncodedDer(id: Int64, format: CString, errCode: CPointer<Int32>): HcfBlob

    func FFiOHOSPriKeyGetEncodedPem(id: Int64, format: CString, errCode: CPointer<Int32>): CString

    func FFiOHOSPriKeyClearMem(id: Int64): Int32

    func FfiOHOSPriKeyGetFormat(id: Int64, errCode: CPointer<Int32>): CString

    func FFiOHOSPubKeyGetAsyKeySpecByNum(id: Int64, itemType: Int32, errCode: CPointer<Int32>): IntNative

    func FFiOHOSPubKeyGetAsyKeySpecByStr(id: Int64, itemType: Int32, errCode: CPointer<Int32>): CString

    func FFiOHOSPubKeyGetAsyKeySpecByBigInt(id: Int64, itemType: Int32, errCode: CPointer<Int32>): HcfBigInteger

    func FFiOHOSPubKeyGetEncoded(id: Int64, errCode: CPointer<Int32>): HcfBlob

    func FFiOHOSPubKeyGetEncodedDer(id: Int64, format: CString, errCode: CPointer<Int32>): HcfBlob

    func FFiOHOSPubKeyGetEncodedPem(id: Int64, format: CString, errCode: CPointer<Int32>): CString

    func FfiOHOSPubKeyGetFormat(id: Int64, errCode: CPointer<Int32>): CString

    func FfiOHOSPubKeyGetRawPointer(id: Int64): CPointer<Unit>

    func FfiOHOSPubKeyFromRawPointer(ptr: CPointer<Unit>, retString: CPointer<CPointer<UInt8>>, errCode: CPointer<Int32>): Int64

    func FFiOHOSKeyPairPubKey(id: Int64, errCode: CPointer<Int32>): Int64

    func FFiOHOSKeyPairPriKey(id: Int64, errCode: CPointer<Int32>): Int64
}

/**
 * Provides APIs for private key operations. PriKey is a child class of Key. It needs to be passed in during
 * asymmetric encryption, signing, and key agreement.
 *
 * The private key can be generated by using the asymmetric key generator AsyKeyGenerator or AsyKeyGeneratorBySpec.
 */
@!APILevel[
    since: "26.1.0",
    syscap: "SystemCapability.Security.CryptoFramework.Key.AsymKey"
]
public class PriKey <: RemoteDataLite & Key {
    private let _algName: String

    init(id: Int64, algName: String) {
        super(id)
        _algName = algName
    }

    ~init() {
        releaseFFIData(myDataId)
    }

    /**
     * Indicates the format of the key object.
     */
    @!APILevel[
        since: "26.1.0",
        syscap: "SystemCapability.Security.CryptoFramework.Key"
    ]
    public prop format: String {
        get() {
            unsafe {
                var errCode: Int32 = 0
                let cstr = FfiOHOSPriKeyGetFormat(getID(), inout errCode)
                checkAndThrow(errCode)
                return cstr.toString()
            }
        }
    }

    /**
     * Indicates the algorithm name of the key object. This parameter contains the key length if the key is a symmetric
     * key.
     */
    @!APILevel[
        since: "26.1.0",
        syscap: "SystemCapability.Security.CryptoFramework.Key"
    ]
    public prop algName: String {
        get() {
            return _algName
        }
    }

    /**
     * Obtains a key parameter. This API returns the result synchronously.
     *
     * @param { AsyKeySpecItem } itemType - Key parameter type to obtain.
     * @returns { ResultSpec } Content of the key parameter obtained.
     * @throws { BusinessException } 801 - This operation is not supported.
     * @throws { BusinessException } 17620001 - Memory operation failed.
     * @throws { BusinessException } 17630001 - Crypto operation error.
     * @throws { BusinessException } 17620003 - Parameter check failed.
     */
    @!APILevel[
        since: "26.1.0",
        syscap: "SystemCapability.Security.CryptoFramework.Key.AsymKey",
        throwexception: true
    ]
    public func getAsyKeySpec(itemType: AsyKeySpecItem): ResultSpec {
        let asyKeySpecItemType = getAsyKeySpecType(itemType.value)
        if (asyKeySpecItemType == SPEC_ITEM_TYPE_BIG_INT) {
            unsafe {
                var errCode: Int32 = 0
                let returnBigInt = FFiOHOSPriKeyGetAsyKeySpecByBigInt(getID(), itemType.value, inout errCode)
                checkAndThrow(errCode)
                let res = ResultSpec.BigintValue(BigInt(true, returnBigInt.toArray()))
                returnBigInt.free()
                return res
            }
        } else if (asyKeySpecItemType == SPEC_ITEM_TYPE_NUM) {
            unsafe {
                var errCode: Int32 = 0
                let returnNum = FFiOHOSPriKeyGetAsyKeySpecByNum(getID(), itemType.value, inout errCode)
                checkAndThrow(errCode)
                return ResultSpec.Int32Value(Int32(returnNum))
            }
        } else if (asyKeySpecItemType == SPEC_ITEM_TYPE_STR) {
            unsafe {
                var errCode: Int32 = 0
                let returnString = FFiOHOSPriKeyGetAsyKeySpecByStr(getID(), itemType.value, inout errCode)
                checkAndThrow(errCode)
                let res = ResultSpec.StringValue(returnString.toString())
                LibC.free(returnString)
                return res
            }
        }
        throw BusinessException(ERR_PARAMETER_ERROR, "AsyKeySpecItem not support!")
    }

    /**
     * Obtains the private key data that complies with the ASN.1 syntax and DER encoding based on the specified format
     * (such as the key specifications).
     *
     * Note:
     * The difference between Key.getEncoded() and this API is as follows:
     * 1. You can specify the format of the key data to be obtained in this API.
     * 2. The format of the key data to be obtained cannot be specified in Key.getEncoded().
     *
     * @param { String } format - Format of the key. Supports EC keys, with the format value 'PKCS8' supported.
     *     Since API version 26.0.0, RSA keys are supported, with the format values 'PKCS1' and 'PKCS8' supported.
     *     Since API version 26.0.0, ML-DSA and ML-KEM keys are supported, with the format value 'X509' supported.
     * @returns { DataBlob } Private key data in DER encoding.
     * @throws { BusinessException } 17620001 - Memory operation failed.
     * @throws { BusinessException } 17630001 - Crypto operation error.
     * @throws { BusinessException } 17620003 - Parameter check failed.
     */
    @!APILevel[
        since: "26.1.0",
        syscap: "SystemCapability.Security.CryptoFramework.Key.AsymKey",
        throwexception: true
    ]
    public func getEncodedDer(format: String): DataBlob {
        unsafe {
            let cformat = LibC.mallocCString(format)
            var errCode: Int32 = 0
            let returnBlob: HcfBlob = FFiOHOSPriKeyGetEncodedDer(getID(), cformat, inout errCode)
            LibC.free(cformat)
            checkAndThrow(errCode)
            let blob = returnBlob.toDataBlob()
            returnBlob.free()
            return blob
        }
    }

    /**
     * Obtains the private key data in PEM encoding. This API returns the result synchronously.
     *
     * @param { String } format - Encoding format of the key data to obtain. Supports RSA keys, with the format value
     *     'PKCS8' or 'PKCS1' supported.
     *     Since API version 26.0.0, EC keys are supported, with the format values 'PKCS8' or 'EC' supported.
     *     Since API version 26.0.0, ML-DSA and ML-KEM keys are supported, with the format value 'PKCS8' supported.
     * @returns { String } Private key data in PEM encoding.
     * @throws { BusinessException } 17620001 - Memory operation failed.
     * @throws { BusinessException } 17630001 - Crypto operation error.
     * @throws { BusinessException } 17620003 - Parameter check failed.
     */
    @!APILevel[
        since: "26.1.0",
        syscap: "SystemCapability.Security.CryptoFramework.Key.AsymKey",
        throwexception: true
    ]
    public func getEncodedPem(format: String): String {
        unsafe {
            let cformat = LibC.mallocCString(format)
            var errCode: Int32 = 0
            let ret: CString = FFiOHOSPriKeyGetEncodedPem(getID(), cformat, inout errCode)
            LibC.free(cformat)
            checkAndThrow(errCode)
            let str = ret.toString()
            LibC.free(ret)
            return str
        }
    }

    /**
     * Encode the key object to binary data.
     * The key can be a symmetric key, public key, or private key.
     * The public key must be in DER encoding format and comply with the ASN.1 syntax and X.509 specifications.
     * The private key must be in DER encoding format and comply with the ASN.1 syntax and PKCS#8 specifications.
     *
     * @returns { DataBlob } the binary data of the key object.
     * @throws { BusinessException } 801 - this operation is not supported.
     * @throws { BusinessException } 17620001 - memory operation failed.
     * @throws { BusinessException } 17630001 - crypto operation error.
     */
    @!APILevel[
        since: "26.1.0",
        syscap: "SystemCapability.Security.CryptoFramework.Key",
        throwexception: true
    ]
    public func getEncoded(): DataBlob {
        unsafe {
            var errCode: Int32 = 0
            let returnBlob: HcfBlob = FFiOHOSPriKeyGetEncoded(getID(), inout errCode)
            checkAndThrow(errCode)
            let blob = returnBlob.toDataBlob()
            returnBlob.free()
            return blob
        }
    }

    /**
     * Clears the key data in memory. This API returns the result synchronously.
     */
    @!APILevel[
        since: "26.1.0",
        syscap: "SystemCapability.Security.CryptoFramework.Key.AsymKey"
    ]
    public func clearMem(): Unit {
        unsafe {
            let errCode = FFiOHOSPriKeyClearMem(getID())
            checkAndThrow(errCode)
        }
    }
}

/**
 * Provides APIs for public key operations. PubKey is a child class of Key. It needs to be passed in during
 * asymmetric encryption, signature verification, and key agreement.
 *
 * The public key can be generated by using the asymmetric key generator AsyKeyGenerator or AsyKeyGeneratorBySpec.
 */
@!APILevel[
    since: "26.1.0",
    syscap: "SystemCapability.Security.CryptoFramework.Key.AsymKey"
]
public class PubKey <: RemoteDataLite & Key {
    private let _algName: String

    init(id: Int64, algName: String) {
        super(id)
        _algName = algName
    }

    ~init() {
        releaseFFIData(myDataId)
    }

    /**
     * Indicates the format of the key object.
     */
    @!APILevel[
        since: "26.1.0",
        syscap: "SystemCapability.Security.CryptoFramework.Key"
    ]
    public prop format: String {
        get() {
            unsafe {
                var errCode: Int32 = 0
                let cstr = FfiOHOSPubKeyGetFormat(getID(), inout errCode)
                checkAndThrow(errCode)
                return cstr.toString()
            }
        }
    }

    /**
     * Indicates the algorithm name of the key object. This parameter contains the key length if the key is a symmetric
     * key.
     */
    @!APILevel[
        since: "26.1.0",
        syscap: "SystemCapability.Security.CryptoFramework.Key"
    ]
    public prop algName: String {
        get() {
            return _algName
        }
    }

    /**
     * Obtains a key parameter. This API returns the result synchronously.
     *
     * @param { AsyKeySpecItem } itemType - Key parameter to obtain.
     * @returns { ResultSpec } Content of the key parameter obtained.
     * @throws { BusinessException } 17620001 - Memory operation failed.
     * @throws { BusinessException } 17630001 - Crypto operation error.
     * @throws { BusinessException } 801 - This operation is not supported.
     * @throws { BusinessException } 17620003 - Parameter check failed.
     */
    @!APILevel[
        since: "26.1.0",
        syscap: "SystemCapability.Security.CryptoFramework.Key.AsymKey",
        throwexception: true
    ]
    public func getAsyKeySpec(itemType: AsyKeySpecItem): ResultSpec {
        let asyKeySpecItemType = getAsyKeySpecType(itemType.value)
        if (asyKeySpecItemType == SPEC_ITEM_TYPE_BIG_INT) {
            unsafe {
                var errCode: Int32 = 0
                let returnBigInt = FFiOHOSPubKeyGetAsyKeySpecByBigInt(getID(), itemType.value, inout errCode)
                checkAndThrow(errCode)
                let res = ResultSpec.BigintValue(BigInt(true, returnBigInt.toArray()))
                returnBigInt.free()
                return res
            }
        } else if (asyKeySpecItemType == SPEC_ITEM_TYPE_NUM) {
            unsafe {
                var errCode: Int32 = 0
                let returnNum = FFiOHOSPubKeyGetAsyKeySpecByNum(getID(), itemType.value, inout errCode)
                checkAndThrow(errCode)
                return ResultSpec.Int32Value(Int32(returnNum))
            }
        } else if (asyKeySpecItemType == SPEC_ITEM_TYPE_STR) {
            unsafe {
                var errCode: Int32 = 0
                let returnString = FFiOHOSPubKeyGetAsyKeySpecByStr(getID(), itemType.value, inout errCode)
                checkAndThrow(errCode)
                let res = ResultSpec.StringValue(returnString.toString())
                LibC.free(returnString)
                return res
            }
        }
        throw BusinessException(ERR_PARAMETER_ERROR, "AsyKeySpecItem not support!")
    }

    /**
     * Obtains the public key data that complies with the ASN.1 syntax and DER encoding format based on the specified
     * key format (such as the specifications and compression status).
     *
     * Note:
     * The difference between Key.getEncoded() and this API is as follows:
     * 1. You can specify the format of the data to be obtained in this API.
     * 2. The format of the key to be obtained cannot be specified in Key.getEncoded().
     *
     * @param { String } format - Format of the key. Supports EC keys, with the format values 'X509|COMPRESSED' and
     *     'X509|UNCOMPRESSED' supported.
     *     Since API version 26.0.0, RSA keys are supported, with the format values 'PKCS1' and 'X509' supported.
     *     Since API version 26.0.0, ML-DSA and ML-KEM keys are supported, with the format value 'X509' supported.
     * @returns { DataBlob } Public key data in DER encoding.
     * @throws { BusinessException } 17620001 - Memory operation failed.
     * @throws { BusinessException } 17630001 - Crypto operation error.
     * @throws { BusinessException } 17620003 - Parameter check failed.
     */
    @!APILevel[
        since: "26.1.0",
        syscap: "SystemCapability.Security.CryptoFramework.Key.AsymKey",
        throwexception: true
    ]
    public func getEncodedDer(format: String): DataBlob {
        unsafe {
            let cformat = LibC.mallocCString(format)
            var errCode: Int32 = 0
            let returnBlob: HcfBlob = FFiOHOSPubKeyGetEncodedDer(getID(), cformat, inout errCode)
            LibC.free(cformat)
            checkAndThrow(errCode)
            let blob = returnBlob.toDataBlob()
            returnBlob.free()
            return blob
        }
    }

    /**
     * Obtains the public key data in PEM encoding. This API returns the result synchronously.
     *
     * @param { String } format - Encoding format of the key data to obtain. Supports RSA keys, with the format values
     *     'X509' or 'PKCS1' supported.
     *     Since API version 26.0.0, EC, ML-DSA, and ML-KEM keys are supported, with the format value 'X509'
     *     supported.
     * @returns { String } Public key data in PEM encoding.
     * @throws { BusinessException } 17620001 - Memory operation failed.
     * @throws { BusinessException } 17630001 - Crypto operation error.
     * @throws { BusinessException } 17620003 - Parameter check failed.
     */
    @!APILevel[
        since: "26.1.0",
        syscap: "SystemCapability.Security.CryptoFramework.Key.AsymKey",
        throwexception: true
    ]
    public func getEncodedPem(format: String): String {
        unsafe {
            let cformat = LibC.mallocCString(format)
            var errCode: Int32 = 0
            let ret: CString = FFiOHOSPubKeyGetEncodedPem(getID(), cformat, inout errCode)
            LibC.free(cformat)
            checkAndThrow(errCode)
            let str = ret.toString()
            LibC.free(ret)
            return str
        }
    }

    /**
     * Encode the key object to binary data.
     * The key can be a symmetric key, public key, or private key.
     * The public key must be in DER encoding format and comply with the ASN.1 syntax and X.509 specifications.
     * The private key must be in DER encoding format and comply with the ASN.1 syntax and PKCS#8 specifications.
     *
     * @returns { DataBlob } the binary data of the key object.
     * @throws { BusinessException } 801 - this operation is not supported.
     * @throws { BusinessException } 17620001 - memory operation failed.
     * @throws { BusinessException } 17630001 - crypto operation error.
     */
    @!APILevel[
        since: "26.1.0",
        syscap: "SystemCapability.Security.CryptoFramework.Key",
        throwexception: true
    ]
    public func getEncoded(): DataBlob {
        unsafe {
            var errCode: Int32 = 0
            let returnBlob: HcfBlob = FFiOHOSPubKeyGetEncoded(getID(), inout errCode)
            checkAndThrow(errCode)
            let blob = returnBlob.toDataBlob()
            returnBlob.free()
            return blob
        }
    }

    func getRawPointer(): CPointer<Unit> {
        return unsafe { FfiOHOSPubKeyGetRawPointer(getID()) }
    }

    static func createFromRawPointer(ptr: CPointer<Unit>): PubKey {
        unsafe {
            var errCode: Int32 = 0
            var retString = CPointer<UInt8>()
            let id = FfiOHOSPubKeyFromRawPointer(ptr, inout retString, inout errCode)
            checkAndThrow(errCode)
            return PubKey(id, CString(retString).toString())
        }
    }
}

/**
 * Defines an asymmetric key pair, which includes a public key and a private key.
 *
 * The asymmetric key pair can be generated by using the asymmetric key generator AsyKeyGenerator or
 * AsyKeyGeneratorBySpec.
 *
 * Note:
 * The pubKey and priKey objects are members of the KeyPair object. When the KeyPair object is out of the scope, its
 * pubKey and priKey objects will be destructed.
 *
 * The service must reference the KeyPair object instead of the internal pubKey or priKey object.
 */
@!APILevel[
    since: "26.1.0",
    syscap: "SystemCapability.Security.CryptoFramework.Key.AsymKey"
]
public class KeyPair <: RemoteDataLite {
    private let _algName: String
    private let _pubKey: ?PubKey
    private let _priKey: ?PriKey

    init(id: Int64, algName: String) {
        super(id)
        _algName = algName

        unsafe {
            var errCode: Int32 = 0
            let pubId = FFiOHOSKeyPairPubKey(getID(), inout errCode)
            _pubKey = if (errCode == 0) {
                PubKey(pubId, algName)
            } else {
                None
            }
            errCode = 0
            let priId = FFiOHOSKeyPairPriKey(getID(), inout errCode)
            _priKey = if (errCode == 0) {
                PriKey(priId, algName)
            } else {
                None
            }
        }
    }

    ~init() {
        releaseFFIData(myDataId)
    }

    /**
     * KeyPair's private key.
     */
    @!APILevel[
        since: "26.1.0",
        syscap: "SystemCapability.Security.CryptoFramework.Key.AsymKey"
    ]
    public prop priKey: PriKey {
        get() {
            _priKey ?? throw BusinessException(ERR_PARAMETER_ERROR, "[KeyPair] priKey: Parameter error.")
        }
    }

    /**
     * KeyPair's public key.
     */
    @!APILevel[
        since: "26.1.0",
        syscap: "SystemCapability.Security.CryptoFramework.Key.AsymKey"
    ]
    public prop pubKey: PubKey {
        get() {
            _pubKey ?? throw BusinessException(ERR_PARAMETER_ERROR, "[KeyPair] pubKey: Parameter error.")
        }
    }
}
